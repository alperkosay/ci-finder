{
  "name": "@ci-finder/next",
  "version": "0.1.0",
  "description": "ciFinder for Next.js: App Router API route, uploads route and standalone-aware project paths for a drop-in file manager.",
  "license": "MIT",
  "author": "Alper Koşay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alperkosay/ci-finder.git",
    "directory": "packages/next"
  },
  "homepage": "https://alperkosay.github.io/ci-finder/docs/next.html",
  "bugs": "https://github.com/alperkosay/ci-finder/issues",
  "keywords": [
    "file-manager",
    "file-browser",
    "nextjs",
    "next",
    "app-router",
    "standalone",
    "uploads",
    "elfinder",
    "s3"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ci-finder/core": "0.1.0"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
